@model Consulta

@{
    ViewData["Title"] = "Editar Consulta";
}

<h1>Editar Consulta</h1>

<form asp-action="Edit" asp-route-id="@Model.IdConsulta" method="post">
    <input type="hidden" asp-for="IdConsulta" />
    <input type="hidden" asp-for="IdMedico" />
    <input type="hidden" asp-for="IdCliente" />    <div class="form-group">
        <label asp-for="Data" class="control-label">Data da Consulta</label>
        <input asp-for="Data" type="date" class="form-control" required />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Horario" class="control-label">Horário</label>
        <input asp-for="Horario" type="time" class="form-control" required />
        <span asp-validation-for="Horario" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <a asp-controller="Cliente" asp-action="VerConsultas" class="btn btn-secondary">Voltar</a>
    </div>
</form>

<div>
    @* <a asp-action="VerConsultas" asp-controller="Cliente" class="btn btn-secondary">Voltar</a> *@
    <a onclick="voltarParaIndex()" class="btn btn-secondary">Voltar</a>
</div>


<script>
    function voltarParaIndex() {
        window.history.back();
    }
</script>"